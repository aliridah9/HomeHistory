# HomeHistory Real Estate Data Ingestion Configuration
# Copy this file to .env and update with your actual values

# =============================================================================
# API CREDENTIALS (Required)
# =============================================================================

# ATTOM Data API Key (Required)
# Get your API key from: https://api.developer.attomdata.com/
HH_ATTOM_API_KEY=your_attom_api_key_here

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================

# Primary database connection URL (Required for database storage)
# Format: postgresql://username:password@host:port/database
HH_DATABASE_URL=postgresql://postgres:password@localhost:5432/hh_ingest

# Direct database URL for write operations (Optional)
# Use this if you have separate read/write database URLs (e.g., Supabase)
# If not provided, will use DATABASE_URL for all operations
HH_DIRECT_URL=postgresql://postgres:password@localhost:5432/hh_ingest

# =============================================================================
# STORAGE CONFIGURATION
# =============================================================================

# Storage mode: where to save collected data
# Options: "json" (files only), "db" (database only), "both" (files + database)
HH_SCRAPER_MODE=both

# Directory for JSON output files (when using "json" or "both" modes)
# Will be created if it doesn't exist
HH_OUTPUT_DIR=./output

# =============================================================================
# REGIONAL CONFIGURATION
# =============================================================================

# Comma-separated list of regions to process
# Available regions:
#   - los_angeles_county (Los Angeles County, CA)
#   - houston_metro (Houston Metro Area, TX)
#   - dfw_metro (Dallas-Fort Worth Metro, TX)
#   - austin_metro (Austin Metro Area, TX)
#   - san_antonio_metro (San Antonio Metro Area, TX)
HH_REGIONS=los_angeles_county,houston_metro,dfw_metro,austin_metro,san_antonio_metro

# =============================================================================
# NETWORK CONFIGURATION (Optional)
# =============================================================================

# HTTP proxy for all requests (Optional)
# Format: http://host:port or https://host:port
# Leave empty if no proxy needed
HH_HTTP_PROXY=

# User agent pool size for rotation (Optional, default: 50)
# Number of different user agents to rotate through
HH_USER_AGENT_POOL_SIZE=50

# =============================================================================
# COMPLIANCE SETTINGS (Optional)
# =============================================================================

# Respect robots.txt files (default: true)
# STRONGLY RECOMMENDED to keep as true for ethical scraping
HH_RESPECT_ROBOTS_TXT=true

# =============================================================================
# FEATURE FLAGS (Optional)
# =============================================================================

# Enable ATTOM API data collection (default: true)
HH_ENABLE_ATTOM_API=true

# Enable Playwright browser automation (default: true)
HH_ENABLE_PLAYWRIGHT=true

# Enable crime statistics collection (default: true)
HH_ENABLE_CRIME_DATA=true

# Enable school data collection (default: true)
HH_ENABLE_SCHOOL_DATA=true

# =============================================================================
# LOGGING CONFIGURATION (Optional)
# =============================================================================

# Logging level (default: INFO)
# Options: DEBUG, INFO, WARNING, ERROR
HH_LOG_LEVEL=INFO

# Log file path (Optional)
# Leave empty to log only to console
# Example: ./logs/hh_ingest.log
HH_LOG_FILE=

# =============================================================================
# TROUBLESHOOTING COMMON ISSUES
# =============================================================================

# Issue: "Database connection failed"
# Solution: Check HH_DATABASE_URL format and database availability

# Issue: "ATTOM API authentication failed"  
# Solution: Verify HH_ATTOM_API_KEY is correct and active

# Issue: "Rate limited by portal"
# Solution: Check rate limiting settings

# =============================================================================
# SUPPORT
# =============================================================================

# For configuration help: https://github.com/homehistory/hh-ingest/wiki
# For issues: https://github.com/homehistory/hh-ingest/issues
# For commercial support: support@homehistory.com

# =============================================================================
# PORTAL SCRAPING CONFIGURATION
# =============================================================================

# Enabled portals (comma-separated)
# Options: zillow, redfin, homes
HH_ENABLED_PORTALS=redfin,zillow

# Zillow browser settings
HH_ZILLOW_HEADLESS=true
