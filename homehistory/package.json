{
  "name": "homehistory",
  "version": "1.0.0",
  "private": true,
  "description": "HomeHistory - A comprehensive home management platform",
  "workspaces": [
    "apps/*",
    "packages/*",
    "docs"
  ],
  "scripts": {
    "dev": "pnpm run --parallel --filter './apps/**' dev",
    "dev:web": "pnpm --filter @homehistory/web dev",
    "dev:api": "pnpm --filter @homehistory/api dev",
    "dev:docs": "pnpm --filter @homehistory/docs dev",
    "build": "pnpm run --filter './apps/**' --filter './packages/**' build",
    "build:web": "pnpm --filter @homehistory/web build",
    "build:api": "pnpm --filter @homehistory/api build",
    "build:docs": "pnpm --filter @homehistory/docs build",
    "test": "pnpm run --parallel --filter './apps/**' --filter './packages/**' test",
    "lint": "pnpm run --parallel --filter './apps/**' --filter './packages/**' lint",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,json,css,scss,md}\"",
    "format:check": "prettier --check \"**/*.{js,jsx,ts,tsx,json,css,scss,md}\"",
    "typecheck": "pnpm run --parallel --filter './apps/**' --filter './packages/**' typecheck",
    "clean": "pnpm run --parallel --filter './apps/**' --filter './packages/**' clean && rimraf node_modules",
    "prepare": "husky install",
    "commit": "cz",
    "release": "semantic-release"
  },
  "devDependencies": {
    "@commitlint/cli": "^18.4.3",
    "@commitlint/config-conventional": "^18.4.3",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "@typescript-eslint/eslint-plugin": "^6.15.0",
    "@typescript-eslint/parser": "^6.15.0",
    "commitizen": "^4.3.0",
    "cz-conventional-changelog": "^3.3.0",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.1.0",
    "husky": "^8.0.3",
    "lint-staged": "^15.2.0",
    "prettier": "^3.1.1",
    "rimraf": "^5.0.5",
    "semantic-release": "^22.0.12",
    "turbo": "^1.11.2",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  },
  "packageManager": "pnpm@8.14.0",
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  }
}
