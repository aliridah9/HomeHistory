# HomeHistory Full-Stack Application
# Multi-stage Docker build for Node.js backend and React frontend

# =============================================================================
# Base Stage - Common Node.js setup
# =============================================================================
FROM node:18-alpine AS base

# Set environment variables
ENV NODE_ENV=production \
    PNPM_HOME="/pnpm" \
    PATH="$PNPM_HOME:$PATH"

# Install pnpm
RUN corepack enable && corepack prepare pnpm@8.14.0 --activate

# Install system dependencies
RUN apk add --no-cache \
    # Build tools
    python3 \
    make \
    g++ \
    # PostgreSQL client
    postgresql-client \
    # SSL/TLS support
    ca-certificates \
    # Utilities
    curl \
    wget

# Create application user for security
RUN addgroup -g 1001 -S nodejs && \
    adduser -S homehistory -u 1001

# Set working directory
WORKDIR /app

# =============================================================================
# Dependencies Stage - Install all dependencies
# =============================================================================
FROM base AS dependencies

# Copy package files
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY homehistory/package.json ./homehistory/
COPY homehistory/apps/api/package.json ./homehistory/apps/api/
COPY homehistory/apps/web/package.json ./homehistory/apps/web/
COPY homehistory/packages/*/package.json ./homehistory/packages/*/

# Install dependencies
RUN pnpm install --frozen-lockfile --prod=false

# =============================================================================
# Backend Build Stage
# =============================================================================
FROM dependencies AS backend-build

# Copy backend source code
COPY homehistory/apps/api ./homehistory/apps/api
COPY homehistory/packages ./homehistory/packages
COPY homehistory/tsconfig.base.json ./homehistory/

# Build backend
WORKDIR /app/homehistory
RUN pnpm --filter @homehistory/api build

# =============================================================================
# Frontend Build Stage
# =============================================================================
FROM dependencies AS frontend-build

# Copy frontend source code
COPY homehistory/apps/web ./homehistory/apps/web
COPY homehistory/packages ./homehistory/packages
COPY homehistory/tsconfig.base.json ./homehistory/

# Build frontend
WORKDIR /app/homehistory
RUN pnpm --filter @homehistory/web build

# =============================================================================
# Backend Production Stage
# =============================================================================
FROM base AS backend

# Copy built backend
COPY --from=backend-build /app/homehistory/apps/api/dist ./homehistory/apps/api/dist
COPY --from=backend-build /app/homehistory/apps/api/package.json ./homehistory/apps/api/
COPY --from=backend-build /app/homehistory/packages ./homehistory/packages
COPY --from=backend-build /app/node_modules ./node_modules
COPY --from=backend-build /app/homehistory/node_modules ./homehistory/node_modules

# Copy Prisma files
COPY homehistory/packages/database/prisma ./homehistory/packages/database/prisma

# Set working directory
WORKDIR /app/homehistory/apps/api

# Create logs directory
RUN mkdir -p logs

# Set ownership
RUN chown -R homehistory:nodejs /app

# Switch to application user
USER homehistory

# Expose port
EXPOSE 3001

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=30s --retries=3 \
    CMD curl -f http://localhost:3001/health || exit 1

# Start backend
CMD ["node", "dist/main.js"]

# =============================================================================
# Frontend Production Stage (Nginx)
# =============================================================================
FROM nginx:alpine AS frontend

# Copy built frontend
COPY --from=frontend-build /app/homehistory/apps/web/dist /usr/share/nginx/html

# Copy nginx configuration
COPY docker/nginx/nginx.conf /etc/nginx/nginx.conf
COPY docker/nginx/default.conf /etc/nginx/conf.d/default.conf

# Create nginx user
RUN addgroup -g 1001 -S nginx-app && \
    adduser -S nginx-app -u 1001 -G nginx-app

# Set ownership
RUN chown -R nginx-app:nginx-app /usr/share/nginx/html /var/cache/nginx /var/run /var/log/nginx

# Switch to application user
USER nginx-app

# Expose port
EXPOSE 3000

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=30s --retries=3 \
    CMD curl -f http://localhost:3000 || exit 1

# Start nginx
CMD ["nginx", "-g", "daemon off;"]

# =============================================================================
# Development Stage - Full development environment
# =============================================================================
FROM dependencies AS development

# Install development tools
RUN apk add --no-cache \
    git \
    vim \
    bash

# Copy all source code
COPY homehistory ./homehistory

# Set working directory
WORKDIR /app/homehistory

# Set ownership
RUN chown -R homehistory:nodejs /app

# Switch to application user
USER homehistory

# Default command for development
CMD ["pnpm", "dev"]

# =============================================================================
# Build Arguments and Labels
# =============================================================================

# Build arguments for metadata
ARG BUILD_DATE
ARG VCS_REF
ARG VERSION=latest

# Add metadata labels
LABEL org.opencontainers.image.title="HomeHistory Full-Stack Application" \
    org.opencontainers.image.description="Complete HomeHistory real estate platform with Node.js backend and React frontend" \
    org.opencontainers.image.version="${VERSION}" \
    org.opencontainers.image.created="${BUILD_DATE}" \
    org.opencontainers.image.revision="${VCS_REF}" \
    org.opencontainers.image.vendor="HomeHistory" \
    org.opencontainers.image.licenses="MIT" \
    org.opencontainers.image.url="https://github.com/homehistory/homehistory" \
    org.opencontainers.image.source="https://github.com/homehistory/homehistory" \
    org.opencontainers.image.documentation="https://github.com/homehistory/homehistory/blob/main/README.md"

# =============================================================================
# Usage Examples:
# =============================================================================

# Build backend image:
# docker build --target backend -t homehistory-api:latest -f Dockerfile.fullstack .

# Build frontend image:
# docker build --target frontend -t homehistory-web:latest -f Dockerfile.fullstack .

# Build development image:
# docker build --target development -t homehistory:dev -f Dockerfile.fullstack .

# Run with docker-compose:
# docker-compose -f docker-compose.fullstack.yml up -d
